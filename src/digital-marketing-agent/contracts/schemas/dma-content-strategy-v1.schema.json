{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waooaw.com/schemas/dma/content-strategy/1.0.0",
  "title": "DMA Content Strategy Skill Contract v1",
  "$defs": {
    "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "theme": { "type": "string", "minLength": 1, "maxLength": 120 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "date", "theme", "state"],
      "properties": {
        "day": { "type": "integer", "minimum": 1, "maximum": 30 },
        "date": { "type": "string", "format": "date" },
        "theme": { "$ref": "#/$defs/theme" },
        "state": { "const": "DRAFT" }
      }
    }
  },
  "oneOf": [
    {
      "title": "Input",
      "type": "object",
      "additionalProperties": false,
      "required": ["profileRevision", "researchRevision", "researchStatus", "startDate", "themes"],
      "properties": {
        "profileRevision": { "$ref": "#/$defs/revision" },
        "researchRevision": { "$ref": "#/$defs/revision" },
        "researchStatus": { "enum": ["REVIEWED", "PARTIAL_REVIEWED"] },
        "startDate": { "type": "string", "format": "date" },
        "themes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/theme" } }
      }
    },
    {
      "title": "Output",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "profileRevision", "researchRevision", "calendar", "publicationAllowed", "sideEffects"],
      "properties": {
        "kind": { "const": "CONTENT_STRATEGY_PROPOSAL" },
        "status": { "const": "PENDING_CUSTOMER_APPROVAL" },
        "profileRevision": { "$ref": "#/$defs/revision" },
        "researchRevision": { "$ref": "#/$defs/revision" },
        "calendar": { "type": "array", "minItems": 30, "maxItems": 30, "items": { "$ref": "#/$defs/entry" } },
        "publicationAllowed": { "const": false },
        "sideEffects": { "const": [] }
      }
    }
  ]
}