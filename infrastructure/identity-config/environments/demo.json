{
  "schemaVersion": "1.0",
  "environment": "demo",
  "origins": {
    "web": "https://ca-demo-web.wonderfulmoss-740b2b2d.centralindia.azurecontainerapps.io",
    "api": "https://ca-demo-business-platform.wonderfulmoss-740b2b2d.centralindia.azurecontainerapps.io",
    "identity": "https://ca-demo-identity-edge.wonderfulmoss-740b2b2d.centralindia.azurecontainerapps.io"
  },
  "keycloak": {
    "issuer": "https://ca-demo-identity-edge.wonderfulmoss-740b2b2d.centralindia.azurecontainerapps.io/realms/waooaw",
    "audience": "waooaw-platform",
    "jwksUri": "https://ca-demo-identity-edge.wonderfulmoss-740b2b2d.centralindia.azurecontainerapps.io/realms/waooaw/protocol/openid-connect/certs",
    "realm": "waooaw",
    "accessTokenMinutes": 15,
    "refreshSessionHours": 8,
    "clockSkewSeconds": 30
  },
  "clients": [
    {
      "id": "waooaw-web",
      "channel": "WEB",
      "pkceRequired": true,
      "redirectUris": [
        "https://ca-demo-web.wonderfulmoss-740b2b2d.centralindia.azurecontainerapps.io/api/auth/callback/keycloak",
        "https://ca-demo-web.wonderfulmoss-740b2b2d.centralindia.azurecontainerapps.io/api/auth/callback/keycloak-google"
      ],
      "postLogoutRedirectUris": ["https://ca-demo-web.wonderfulmoss-740b2b2d.centralindia.azurecontainerapps.io/login"],
      "allowedOrigins": ["https://ca-demo-web.wonderfulmoss-740b2b2d.centralindia.azurecontainerapps.io"],
      "scopes": ["openid", "profile", "email"]
    },
    {
      "id": "waooaw-mobile-demo",
      "channel": "MOBILE",
      "pkceRequired": true,
      "redirectUris": ["https://mobile.demo.waooaw.com/oidc/callback"],
      "postLogoutRedirectUris": ["https://mobile.demo.waooaw.com/logout"],
      "allowedOrigins": [],
      "scopes": ["openid", "profile", "email"]
    }
  ],
  "channels": { "web": true, "mobile": false, "whatsApp": true },
  "cookie": { "name": "waooaw.demo.session", "secure": true, "sameSite": "Lax" },
  "identityEdge": {
    "image": "nginxinc/nginx-unprivileged@sha256:62a904036bfc0e4a4f2b556e34cbf17bc136b47fde8cdb4628762725f48c5782",
    "routePolicy": "infrastructure/terraform/phase2/modules/workload/identity-edge.conf.tftpl"
  },
  "phoneIdentity": { "internalAudience": "waooaw-phone-identity-demo" },
  "providers": [
    { "id": "GOOGLE", "displayName": "Google", "authenticationPath": "GOOGLE", "enabled": false, "unavailableReason": "NOT_CONFIGURED", "brokerAlias": "google", "scopes": ["openid", "profile", "email"] },
    { "id": "FACEBOOK", "displayName": "Facebook", "authenticationPath": "META", "enabled": false, "unavailableReason": "NOT_CONFIGURED", "brokerAlias": "facebook", "scopes": ["email", "public_profile"] },
    { "id": "APPLE", "displayName": "Apple", "authenticationPath": "APPLE", "enabled": false, "unavailableReason": "NOT_CONFIGURED", "brokerAlias": "apple", "scopes": ["openid", "name", "email"] },
    { "id": "EMAIL", "displayName": "Email", "authenticationPath": "CREDENTIAL", "enabled": false, "unavailableReason": "NOT_CONFIGURED", "scopes": [] }
  ]
}
