# Local auth-preview identity edge. The Codespaces forwarder reaches listen 8080 over HTTP;
# containers resolve the public identity host to this service and use listen 443 with the
# preview CA. Both present the public HTTPS origin to Keycloak so issuers stay consistent.
server {
    listen 8080;
    listen 443 ssl;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/nginx/auth-preview-tls/server.crt;
    ssl_certificate_key /etc/nginx/auth-preview-tls/server.key;

    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    location / {
        proxy_pass http://keycloak:8080;
        proxy_set_header Host ${AUTH_PREVIEW_IDP_HOST};
        proxy_set_header X-Forwarded-Host ${AUTH_PREVIEW_IDP_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
