# Local auth-preview edge (AUTH_PREVIEW_IDP=local). It owns the single forwarded preview port so the
# browser reaches Keycloak and the web app on one Codespaces origin: /realms and /resources go to
# Keycloak, everything else to the web app. The Codespaces forwarder reaches listen 8080 over HTTP;
# containers resolve the public host to this service and use listen 443 with the preview CA.
server {
    listen 8080;
    listen 443 ssl;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/nginx/auth-preview-tls/server.crt;
    ssl_certificate_key /etc/nginx/auth-preview-tls/server.key;

    # Docker DNS; resolving per request lets the edge start before the web container exists.
    resolver 127.0.0.11 valid=10s ipv6=off;

    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;
    proxy_set_header X-Forwarded-Host ${AUTH_PREVIEW_IDP_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    location ~ ^/(realms|resources)/ {
        set $keycloak http://keycloak:8080;
        proxy_pass $keycloak;
        proxy_set_header Host ${AUTH_PREVIEW_IDP_HOST};
    }

    location / {
        set $web http://auth-preview:3000;
        proxy_pass $web;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
    }
}
