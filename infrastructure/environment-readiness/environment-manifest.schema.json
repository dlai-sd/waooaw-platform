{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waooaw.com/schemas/environment-manifest-1.0.json",
  "title": "WAOOAW Environment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "origins", "keycloak", "clients", "channels", "cookie", "identityEdge", "phoneIdentity", "providers"],
  "allOf": [
    {
      "if": {
        "properties": { "environment": { "enum": ["demo", "uat"] } },
        "required": ["environment"]
      },
      "then": { "required": ["capacityProfile"] }
    },
    {
      "if": {
        "properties": { "environment": { "enum": ["demo", "uat"] } },
        "required": ["environment"]
      },
      "then": { "required": ["sessionAuthority"] }
    }
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "environment": { "enum": ["demo", "uat", "prod"] },
    "origins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "api", "identity"],
      "properties": {
        "web": { "$ref": "#/$defs/httpsUri" },
        "api": { "$ref": "#/$defs/httpsUri" },
        "identity": { "$ref": "#/$defs/httpsUri" }
      }
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience", "jwksUri", "realm", "accessTokenMinutes", "refreshSessionHours", "clockSkewSeconds"],
      "properties": {
        "issuer": { "$ref": "#/$defs/httpsUri" },
        "audience": { "const": "waooaw-platform" },
        "jwksUri": { "$ref": "#/$defs/httpsUri" },
        "realm": { "const": "waooaw" },
        "accessTokenMinutes": { "const": 15 },
        "refreshSessionHours": { "const": 8 },
        "clockSkewSeconds": { "type": "integer", "minimum": 0, "maximum": 60 }
      }
    },
    "clients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/client" } },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "mobile", "whatsApp"],
      "properties": {
        "web": { "type": "boolean" },
        "mobile": { "type": "boolean" },
        "whatsApp": { "type": "boolean" }
      }
    },
    "cookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "secure", "sameSite"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "secure": { "const": true },
        "sameSite": { "enum": ["Lax", "Strict"] }
      }
    },
    "identityEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "routePolicy"],
      "properties": {
        "image": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" },
        "routePolicy": { "type": "string", "minLength": 1 }
      }
    },
    "phoneIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internalAudience"],
      "properties": { "internalAudience": { "type": "string", "minLength": 1 } }
    },
    "capacityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source", "environment"],
      "properties": {
        "id": { "const": "wc123-auth-capacity-v1" },
        "version": { "const": "1.0.0" },
        "source": { "const": "architecture/reference/components/authentication-authorization-capacity-profile.v1.yaml" },
        "environment": { "enum": ["demo", "uat"] }
      }
    },
    "sessionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "mode", "schemaVersion", "compatibleDeployVersions", "cookieName", "idleTimeoutMinutes", "absoluteLifetimeHours", "refreshLeaseSeconds", "operationalRetentionDays", "protocolRetentionHours", "backupRetentionDays", "rpoMinutes", "rtoMinutes", "databasePoolSize", "globalConcurrency", "timeoutsMs", "keyVersions", "requiredSecretIds"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "mode": { "enum": ["DISPOSABLE_RESET", "PERSISTENT_SANITIZED_RESTORE"] },
        "schemaVersion": { "const": 1 },
        "compatibleDeployVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^wc123-[a-z0-9-]+-v[0-9]+$" }
        },
        "cookieName": { "const": "__Host-waooaw-session" },
        "idleTimeoutMinutes": { "const": 30 },
        "absoluteLifetimeHours": { "const": 8 },
        "refreshLeaseSeconds": { "type": "integer", "minimum": 1, "maximum": 15 },
        "operationalRetentionDays": { "const": 30 },
        "protocolRetentionHours": { "const": 24 },
        "backupRetentionDays": { "const": 35 },
        "rpoMinutes": { "type": "integer", "minimum": 1, "maximum": 5 },
        "rtoMinutes": { "type": "integer", "minimum": 1, "maximum": 30 },
        "databasePoolSize": { "const": 5 },
        "globalConcurrency": { "type": "integer", "minimum": 1, "maximum": 300 },
        "timeoutsMs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["poolAcquisition", "refreshLock", "statement", "businessPlatformMembership", "redis", "identityProvider"],
          "properties": {
            "poolAcquisition": { "const": 1000 },
            "refreshLock": { "const": 1500 },
            "statement": { "const": 5000 },
            "businessPlatformMembership": { "const": 3000 },
            "redis": { "const": 500 },
            "identityProvider": { "const": 5000 }
          }
        },
        "keyVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handleDigestWrite", "protocolDigestWrite", "tokenEnvelopeWrite"],
          "properties": {
            "handleDigestWrite": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
            "protocolDigestWrite": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
            "tokenEnvelopeWrite": { "type": "string", "pattern": "^v[1-9][0-9]*$" }
          }
        },
        "requiredSecretIds": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "web-session-handle-digest",
              "web-session-protocol-digest",
              "web-session-token-envelope",
              "web-session-database",
              "web-oidc-client",
              "keycloak-lifecycle-writer-client"
            ]
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "authenticationPath", "enabled", "scopes"],
        "properties": {
          "id": { "enum": ["GOOGLE", "FACEBOOK", "APPLE", "EMAIL"] },
          "displayName": { "type": "string", "minLength": 1 },
          "authenticationPath": { "enum": ["GOOGLE", "META", "APPLE", "CREDENTIAL"] },
          "enabled": { "type": "boolean" },
          "unavailableReason": { "enum": ["NOT_CONFIGURED", "TEMPORARILY_UNAVAILABLE"] },
          "secretReference": { "type": "string", "pattern": "^kv://[a-z0-9-]+/secrets/[a-z0-9-]+$" },
          "readinessEvidenceReference": { "type": "string", "minLength": 1 },
          "brokerAlias": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "httpsUri": { "type": "string", "format": "uri", "pattern": "^https://" },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel", "pkceRequired", "redirectUris", "postLogoutRedirectUris", "allowedOrigins", "scopes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["WEB", "MOBILE"] },
        "pkceRequired": { "const": true },
        "redirectUris": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/httpsUri" } },
        "postLogoutRedirectUris": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/httpsUri" } },
        "allowedOrigins": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/httpsUri" } },
        "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "contains": { "const": "openid" }, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}