      "consumers": ["business-platform:Identity__Hmac__Key"],
      "environments": ["demo", "uat", "prod"],
      "requiredWhen": "identity mutation routes enabled",
      "rotationClass": "versioned-90-day-overlap",
      "validation": "enabled unexpired 32-byte minimum",
      "owner": "INST-007",
      "principal": "business-platform",
      "allowedOperations": ["get"],
      "compromiseAction": "disable writes and lookup/link/merge; rotate and requalify"
    },
    {
