      "environments": ["demo", "uat", "prod"],
      "requiredWhen": "keycloak enabled",
      "rotationClass": "90-day",
      "validation": "enabled unexpired 32-character minimum",
      "owner": "INST-007",
      "principal": "keycloak",
      "allowedOperations": ["get"],
      "compromiseAction": "disable version; halt identity readiness; rotate"
    },
    {
