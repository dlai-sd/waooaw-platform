{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waooaw.com/schemas/secret-catalog-1.0.json",
  "title": "WAOOAW Secret Dependency Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "vaultSecretName", "purpose", "source", "consumers", "environments", "requiredWhen", "rotationClass", "validation", "owner", "principal", "allowedOperations", "compromiseAction"],
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "whatsapp-provider-binding", "whatsapp-verify-token",
                    "whatsapp-app-secret", "whatsapp-outbound-authority"
                  ]
                }
              }
            },
            "then": {
              "required": ["readinessGate"],
              "properties": { "readinessGate": { "const": "demo-whatsapp-provider" } }
            },
            "else": {
              "if": { "properties": { "id": { "const": "whatsapp-media-authority" } } },
              "then": {
                "required": ["readinessGate"],
                "properties": { "readinessGate": { "const": "demo-whatsapp-media" } }
              },
              "else": {
                "properties": { "readinessGate": { "const": "environment-configuration" } }
              }
            }
          }
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "vaultSecretName": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "purpose": { "type": "string", "minLength": 1 },
          "source": { "enum": ["platform-generated", "external-operator", "external-managed"] },
          "provisioner": {
            "enum": [
              "environment-deployment",
              "founder-key-vault-admin",
              "wc123-no-echo-provisioner",
              "wc124-db-provisioner",
              "wc124-recovery-provisioner"
            ]
          },
          "consumers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "environments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["demo", "uat", "prod"] } },
          "requiredWhen": { "type": "string", "minLength": 1 },
          "readinessGate": {
            "enum": ["environment-configuration", "demo-whatsapp-provider", "demo-whatsapp-media"]
          },
          "rotationClass": { "type": "string", "minLength": 1 },
          "validation": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "principal": { "type": "string", "minLength": 1 },
          "allowedOperations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["get", "list", "set"] } },
          "compromiseAction": { "type": "string", "minLength": 1 },
          "rotationCadenceDays": { "type": "integer", "minimum": 1, "maximum": 365 },
          "maximumOverlapHours": { "type": "integer", "minimum": 0, "maximum": 168 },
          "expiresAfterDays": { "type": "integer", "minimum": 1, "maximum": 730 },
          "retirementGuard": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}