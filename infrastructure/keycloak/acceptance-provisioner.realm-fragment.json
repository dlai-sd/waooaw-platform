{
  "schema": "waooaw.keycloak-realm-fragment/v1",
  "decision": "ADR-055 decision 2",
  "environments": ["demo", "uat"],
  "applyPath": "Read by infrastructure/terraform/phase2/modules/workload/acceptance-provisioner.tf and merged into the realm import only when acceptance_provisioner_enabled is true (Demo only, WC-167). The client secret placeholder is filled from the acceptance vault by the Keycloak migration job.",
  "realm": {
    "adminEventsEnabled": true,
    "adminEventsDetailsEnabled": false,
    "roles": { "realm": [{ "name": "acceptance-provisioner", "description": "Held only by the acceptance provisioning client; never assignable to customers." }] },
    "groups": [{ "name": "synthetic" }],
    "userProfile": {
      "attributes": [
        { "name": "username", "displayName": "${username}", "validations": { "length": { "min": 3, "max": 255 }, "username-prohibited-characters": {}, "up-username-not-idn-homograph": {} }, "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] }, "multivalued": false },
        { "name": "email", "displayName": "${email}", "validations": { "email": {}, "length": { "max": 255 } }, "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] }, "multivalued": false },
        { "name": "firstName", "displayName": "${firstName}", "validations": { "length": { "max": 255 }, "person-name-prohibited-characters": {} }, "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] }, "multivalued": false },
        { "name": "lastName", "displayName": "${lastName}", "validations": { "length": { "max": 255 }, "person-name-prohibited-characters": {} }, "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] }, "multivalued": false },
        { "name": "synthetic_idp", "displayName": "synthetic_idp", "validations": { "options": { "options": ["google", "facebook"] } }, "permissions": { "view": ["admin"], "edit": ["admin"] }, "multivalued": false }
      ],
      "groups": [{ "name": "user-metadata", "displayHeader": "User metadata", "displayDescription": "Attributes, which refer to user metadata" }]
    }
  },
  "clients": [
    {
      "clientId": "waooaw-acceptance-provisioner",
      "name": "WAOOAW Customer Journey Acceptance Provisioner",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ACCEPTANCE_PROVISIONER_CLIENT_SECRET}",
      "defaultClientScopes": ["roles"],
      "optionalClientScopes": [],
      "attributes": { "access.token.lifespan": "60" },
      "protocolMappers": [
        {
          "name": "realm-management-manage-users",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-role-mapper",
          "config": { "role": "realm-management.manage-users" }
        },
        {
          "name": "realm-management-view-events",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-role-mapper",
          "config": { "role": "realm-management.view-events" }
        },
        {
          "name": "realm-acceptance-provisioner",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-role-mapper",
          "config": { "role": "acceptance-provisioner" }
        },
        {
          "name": "audience-waooaw-platform",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "waooaw-platform", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "serviceAccountUsers": [
    {
      "username": "service-account-waooaw-acceptance-provisioner",
      "enabled": true,
      "serviceAccountClientId": "waooaw-acceptance-provisioner",
      "clientRoles": { "realm-management": ["manage-users", "view-events"] },
      "realmRoles": ["acceptance-provisioner"]
    }
  ],
  "rotation": { "class": "90-day versioned overlap", "reference": "keycloak-lifecycle-writer-client-secret (WC-123)" }
}
