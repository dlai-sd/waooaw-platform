# Implements: ADR-045 §1, §2, §4, §6
# Constitutional basis: C-076, C-080

FROM mcr.microsoft.com/dotnet/sdk:9.0-noble@sha256:d07d5770b2b74717bfe882250e981a4e7a756e0240fc4aefcc0ce93c1e8a9c36

RUN --mount=type=cache,id=wc104-dotnet-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=wc104-dotnet-apt-packages,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && (getent group 1000 >/dev/null || groupadd --gid 1000 waooaw) \
    && (getent passwd 1000 >/dev/null || useradd --uid 1000 --gid 1000 --create-home waooaw)

WORKDIR /workspace
ENV DOTNET_CLI_HOME=/tmp/dotnet \
    NUGET_PACKAGES=/opt/nuget/packages

COPY requirements-test.txt /workspace/requirements-test.txt
RUN --mount=type=cache,id=wc104-dotnet-pip,target=/root/.cache/pip,sharing=locked \
    pip install --break-system-packages -r requirements-test.txt

COPY src/constitutional-engine/constitutional-engine.csproj src/constitutional-engine/
COPY src/business-platform/business-platform.csproj src/business-platform/
COPY tests/constitutional-engine.Tests/constitutional-engine.Tests.csproj tests/constitutional-engine.Tests/
COPY tests/business-platform.Tests/business-platform.Tests.csproj tests/business-platform.Tests/
RUN mkdir -p /opt/nuget/packages /opt/dotnet-tools /tmp/dotnet \
    && chown -R 1000:1000 /opt/nuget /opt/dotnet-tools /tmp/dotnet /workspace

USER 1000:1000
RUN --mount=type=cache,id=wc104-dotnet-nuget,target=/tmp/nuget-cache,uid=1000,gid=1000,sharing=locked \
    NUGET_PACKAGES=/tmp/nuget-cache dotnet restore tests/constitutional-engine.Tests/constitutional-engine.Tests.csproj \
    && NUGET_PACKAGES=/tmp/nuget-cache dotnet restore tests/business-platform.Tests/business-platform.Tests.csproj \
    && cp -a /tmp/nuget-cache/. /opt/nuget/packages/ \
    && dotnet tool install --tool-path /opt/dotnet-tools csharpier --version 1.3.0 \
    && dotnet tool install --tool-path /opt/dotnet-tools dotnet-stryker --version 4.9.0

ENV PATH="/opt/dotnet-tools:${PATH}"

CMD ["dotnet", "test"]
