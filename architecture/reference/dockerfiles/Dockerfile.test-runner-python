# Dockerfile.test-runner-python
# constitutional_basis: C-080 (Docker Test Isolation), ADR-045 (Per-Service Lean Images)
# ib_item: IB-009
#
# Python-only test runner. No .NET SDK. No Node.js.
# Use for: all Python service tests (trust-layer, ai-runtime, business-platform, gateway).
#
# Usage:
#   docker compose --profile test-python run --rm test-runner-python pytest tests/trust-layer/ tests/ai-runtime/ -v
#   docker compose --profile test-python run --rm test-runner-python ruff check src/
#
# ADR-045 §2: dependency layers precede code layers.
# ADR-045 §2: --mount=type=cache for pip (no re-download on incremental builds).

FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

RUN groupadd --gid 1000 waooaw && useradd --uid 1000 --gid waooaw --create-home waooaw

WORKDIR /workspace

RUN --mount=type=cache,id=wc104-python-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=wc104-python-apt-packages,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl

# Layer 3: install deps — busted only when requirements-test.txt changes
COPY requirements-test.txt /workspace/requirements-test.txt
RUN --mount=type=cache,id=wc104-python-pip,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements-test.txt

USER waooaw

CMD ["python3", "-m", "pytest", "tests/", "-v", "--tb=short", "--ignore=tests/dotnet", "--ignore=tests/ts"]
