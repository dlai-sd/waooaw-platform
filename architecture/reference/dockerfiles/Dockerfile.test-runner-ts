# Implements: ADR-045 §1, §2, §4, §6
# Constitutional basis: C-076, C-080

FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e

ENV COREPACK_HOME=/opt/corepack

WORKDIR /workspace

RUN mkdir -p "$COREPACK_HOME" \
	&& corepack enable \
	&& corepack prepare pnpm@9.15.9 --activate \
	&& chmod -R a+rX "$COREPACK_HOME"

COPY --chown=1000:1000 web/package.json web/pnpm-lock.yaml /opt/waooaw-web/
COPY --chown=1000:1000 web/patches/ /opt/waooaw-web/patches/
RUN --mount=type=cache,id=wc104-typescript-pnpm,target=/home/node/.local/share/pnpm/store,uid=1000,gid=1000,sharing=locked \
	cd /opt/waooaw-web \
	&& pnpm install --frozen-lockfile \
	&& for executable in /opt/waooaw-web/node_modules/.bin/*; do \
		name="$(basename "$executable")"; \
		printf '#!/bin/sh\nexec "/opt/waooaw-web/node_modules/.bin/%s" "$@"\n' "$name" > "/usr/local/bin/$name"; \
		chmod 0755 "/usr/local/bin/$name"; \
	done

ENV NODE_PATH=/opt/waooaw-web/node_modules \
	PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
	PATH=/opt/waooaw-web/node_modules/.bin:$PATH

USER 1000:1000

CMD ["sh", "-lc", "cd web && jest --runInBand"]
