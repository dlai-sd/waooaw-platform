# Dockerfile.test-runner-azure
# constitutional_basis: C-080 (Docker Test Isolation), ADR-045 (Per-Service Lean Images)
# ib_item: WC-121

FROM mcr.microsoft.com/azure-cli@sha256:4faeb3c955086c3842d4f8cf0ff1d900ce3a1c68c6e6c6430c5e8a3cb882c5aa

ARG CONTAINERAPP_EXTENSION_VERSION=1.3.0b4
ENV AZURE_EXTENSION_DIR=/opt/az-extensions

RUN az extension add \
      --name containerapp \
      --version "$CONTAINERAPP_EXTENSION_VERSION" \
      --allow-preview true \
      --only-show-errors \
    && test "$(az extension show --name containerapp --query version -o tsv)" = "$CONTAINERAPP_EXTENSION_VERSION" \
    && chmod -R a+rX "$AZURE_EXTENSION_DIR"
