{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waooaw.com/schemas/validation-catalog-v1.json",
  "type": "object",
  "required": ["schema", "version", "mode", "runner_supply", "runners", "commands", "gates", "full_gates", "components", "global_triggers"],
  "properties": {
    "schema": {"const": "waooaw.validation-catalog/v1"},
    "version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["shadow", "enforced"]},
    "runner_supply": {"type": "string", "minLength": 1},
    "runners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["compose_service", "profile", "dockerfile", "docker_socket"],
        "properties": {
          "compose_service": {"type": "string"},
          "profile": {"type": "string"},
          "dockerfile": {"type": "string"},
          "docker_socket": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["shell"],
        "properties": {
          "shell": {"type": "string", "minLength": 1},
          "execution": {"enum": ["container", "host"]},
          "runner_required": {"type": "boolean"},
          "tool_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/gate"}
    },
    "full_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["component_id", "service_image", "service_context", "service_dockerfile", "generated_artifacts", "paths", "gates", "reverse_dependencies"],
        "properties": {
          "component_id": {"type": "string"},
          "service_image": {"type": "string"},
          "service_context": {"type": "string"},
          "service_dockerfile": {"type": "string"},
          "generated_artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "gates": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "reverse_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "global_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "always_on_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scoped_paths": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["paths", "gates"],
        "properties": {
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "components": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "documentation_only": {"type": "array", "items": {"type": "string"}},
    "enforced_activation": {"type": "object"},
    "prechecks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["gate", "inputs"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "always": {"type": "boolean"},
          "reusable": {"type": "boolean"},
          "components": {"type": "array", "items": {"type": "string"}},
          "gates": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "release_full_inventory": {"type": "boolean"},
    "main_full_inventory": {"type": "boolean"}
  },
  "additionalProperties": false,
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["gate_id", "runner_id", "command_id", "evidence_class", "cost_class", "resources", "retry_policy", "artifacts", "global_trigger"],
      "properties": {
        "gate_id": {"type": "string"},
        "runner_id": {"type": "string"},
        "command_id": {"type": "string"},
        "evidence_class": {"enum": ["static", "unit", "coverage", "integration", "contract", "browser", "security", "CCT", "release"]},
        "cost_class": {"enum": ["STATIC", "FOCUSED", "INTEGRATION", "MUTATION", "BROWSER", "FUZZ", "HOSTED", "QUALIFICATION"]},
        "resources": {
          "type": "object",
          "required": ["cpus", "memory_mb", "disk_mb", "timeout_seconds", "docker_socket", "concurrency_class"],
          "properties": {
            "cpus": {"type": "number", "exclusiveMinimum": 0},
            "memory_mb": {"type": "integer", "minimum": 128},
            "disk_mb": {"type": "integer", "minimum": 16},
            "timeout_seconds": {"type": "integer", "minimum": 1},
            "docker_socket": {"type": "boolean"},
            "socket_classification": {"enum": ["nested-docker", "host-orchestration", "testcontainers"]},
            "concurrency_class": {"type": "string"}
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {"properties": {"docker_socket": {"const": true}}},
              "then": {"required": ["socket_classification"]},
              "else": {"not": {"required": ["socket_classification"]}}
            }
          ]
        },
        "retry_policy": {"enum": ["none", "transient-infrastructure-once"]},
        "artifacts": {
          "type": "object",
          "required": ["native", "common"],
          "properties": {
            "native": {"type": "array", "items": {"type": "string"}},
            "common": {"type": "string"}
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
          "uniqueItems": true
        },
        "required_services": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "product_image_builds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reusable": {"type": "boolean"},
        "global_trigger": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}